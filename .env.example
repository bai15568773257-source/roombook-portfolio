# Copy this file to .env for a NEW, isolated installation.
# Generate different random values for each required secret. Never commit .env.
TZ=Asia/Tokyo
APP_BASE_URL=http://localhost:8080
REPORT_DIR=/data/reports

# MariaDB: generate separate random hexadecimal passwords (see README).
DB_HOST=meeting-db
DB_PORT=3306
DB_NAME=meeting
DB_USER=meeting_user
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# JWT / Cookie: JWT_SECRET must contain at least 32 characters.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Set true when serving the application over HTTPS.
COOKIE_SECURE=false
PASSWORD_RESET_CODE_MINUTES=15

# Initial administrator for an empty database; this is a fictional address.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Demo Administrator
ADMIN_PASSWORD=

# Optional email delivery. With both providers unconfigured, email is unavailable.
MAIL_PROVIDER=auto
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM_EMAIL=
MAIL_APPROVAL_REQUEST_ENABLED=false
ADMIN_NOTIFICATION_EMAIL=admin@example.com
MAIL_REMINDER_ENABLED=false
MAIL_REMINDER_MINUTES=5
MAIL_REMINDER_INTERVAL_SECONDS=60

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
